              }
            },
            {
              "id": "CVE-2026-87910-libpython3.12-minimal",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-87910 medium vulnerability for libpython3.12-minimal package"
              },
              "fullDescription": {
                "text": "When tarfile extracts a link on a system that doesn't support links, it falls back to extracting a member from the archive. In this case, the filter function is run twice: once for the extracted member, and once with name set to the location of the link. For one of the calls, the return value was ignored. Instead, the member should be skipped if either call returns None."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-87910",
              "help": {
                "text": "Vulnerability CVE-2026-87910\nSeverity: medium\nPackage: libpython3.12-minimal\nVersion: 3.12.3-1ubuntu0.17\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/info/libpython3.12-minimal:amd64.conffiles\nData Namespace: ubuntu:distro:ubuntu:24.04\nLink: [CVE-2026-87910](https://ubuntu.com/security/CVE-2026-87910)",
