            {
              "id": "CVE-2026-72522-libexpat1",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-72522 medium vulnerability for libexpat1 package"
              },
              "fullDescription": {
                "text": "libexpat before 2.8.3 has an out-of-bounds read and resultant infinite loop because low surrogates are treated the same as high surrogates during Unicode processing in the *_toUtf16 functions."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-72522",
