            {
              "id": "CVE-2026-127040-libgnutls30t64",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-127040 medium vulnerability for libgnutls30t64 package"
              },
              "fullDescription": {
                "text": "The RSA-PSK ClientKeyExchange handler in gnutls before 3.8.14 does not return after detecting a memory allocation failure when copying the PSK username, which allows remote attackers to cause a denial of service for a peer under heap pressure."
