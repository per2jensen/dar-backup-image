              }
            },
            {
              "id": "CVE-2026-17084-libpython3.12-minimal",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-17084 medium vulnerability for libpython3.12-minimal package"
              },
              "fullDescription": {
                "text": "The \"stringprep\" module didn't process characters from RFC 3454 tables \nB.2 or B.3 correctly: the latest Unicode codepoint attributes were used \ninstead of the specified Unicode 3.2.0. This behavior would cause \nmismatches when processing domain names using IDNA 2003 (the \"idna\" \ncodec) and the in_table_b2() function of the \"stringprep\" module. This \nonly affects domain names containing characters that were not previously\n registered or had their Unicode attributes such as case-folding \nbehavior updated since Unicode 3.2.0."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-17084",
              "help": {
                "text": "Vulnerability CVE-2026-17084\nSeverity: medium\nPackage: libpython3.12-minimal\nVersion: 3.12.3-1ubuntu0.17\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/info/libpython3.12-minimal:amd64.conffiles\nData Namespace: ubuntu:distro:ubuntu:24.04\nLink: [CVE-2026-17084](https://ubuntu.com/security/CVE-2026-17084)",
