            {
              "id": "CVE-2026-16052-libpython3.12-minimal",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-16052 medium vulnerability for libpython3.12-minimal package"
              },
              "fullDescription": {
                "text": "The http.cookies.Morsel class allows separator semicolons in attribute\nvalues\nand includes them verbatim in all output formats. An attacker who can\ncontrol\nthese values could use this to relax the cookie's Domain or SameSite\nrestrictions."
