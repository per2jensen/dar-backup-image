            {
              "id": "CVE-2026-127039-libgnutls30t64",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-127039 medium vulnerability for libgnutls30t64 package"
              },
              "fullDescription": {
                "text": "The certificate authentication info handling in gnutls from 2.5.9 up to 3.8.13 does not reset the certificate count and list pointer when re-allocation of raw_certificate_list fails, which allows remote attackers to cause a denial of service for a peer under heap pressure."
