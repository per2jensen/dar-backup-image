              },
              "properties": {
                "purls": [
                  "pkg:deb/ubuntu/libexpat1@2.6.1-2ubuntu0.4?arch=amd64\u0026distro=ubuntu-24.04\u0026upstream=expat"
                ],
                "security-severity": "5.9"
              }
            },
            {
              "id": "CVE-2026-56131-libexpat1",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-56131 medium vulnerability for libexpat1 package"
              },
              "fullDescription": {
                "text": "libexpat before 2.8.2 lacks handler call depth tracking for calls to XML_ResumeParser from within handlers in cases of a policy violation. Thus, a use-after-free can occur (similar to the CVE-2026-50219 situation)."
