            {
              "id": "CVE-2026-76957-libexpat1",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-76957 medium vulnerability for libexpat1 package"
              },
              "fullDescription": {
                "text": "libexpat before 2.8.4 lacks handler call depth tracking with custom encoding callbacks. Thus, a use-after-free can occur. NOTE: this is similar to CVE-2026-50219, CVE-2026-56131 and CVE-2026-56412."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-76957",
