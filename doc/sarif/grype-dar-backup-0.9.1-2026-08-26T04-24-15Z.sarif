            {
              "id": "CVE-2026-57062-keyboxd",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-57062 low vulnerability for keyboxd package"
              },
              "fullDescription": {
                "text": "CMS (Cryptographic Message Syntax) parsing in gpgsm in GnuPG through 2.5.20 mishandles the CMS format for AES-GCM because aes-ICVlen is supposed to be 12 bytes but 4 bytes is accepted. NOTE: this is related to CVE-2026-34182."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-57062",
              "help": {
                "text": "Vulnerability CVE-2026-57062\nSeverity: low\nPackage: keyboxd\nVersion: 2.4.4-2ubuntu17.4\nFix Version: \nType: deb\nLocation: /var/lib/dpkg/info/keyboxd.list\nData Namespace: ubuntu:distro:ubuntu:24.04\nLink: [CVE-2026-57062](https://ubuntu.com/security/CVE-2026-57062)",
