                "purls": [
                  "pkg:deb/ubuntu/bsdextrautils@2.39.3-9ubuntu6.5?arch=amd64\u0026distro=ubuntu-24.04\u0026upstream=util-linux"
                ],
                "security-severity": "4.7"
              }
            },
